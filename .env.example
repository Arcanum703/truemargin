# --- Required ---
DATABASE_URL="postgresql://postgres:tm@localhost:5432/truemargin?schema=public" # Postgres connection string (Neon/Supabase/Vercel Postgres in production).
APP_URL="http://localhost:3003"                 # Public origin; must be https:// in production. Used for email links and Stripe redirects.
SESSION_SECRET=""                              # >= 32 random chars. Generate: openssl rand -base64 48

# --- Email (Resend). Leave RESEND_API_KEY empty to log emails to the server console instead. ---
RESEND_API_KEY=""
EMAIL_FROM="TrueMargin <noreply@example.com>"

# --- Billing (Stripe). Leave empty to run without paid plans (trial only). ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""                       # From `stripe listen` locally or the dashboard webhook endpoint.
STRIPE_PRICE_ID=""                             # Monthly recurring price.
STRIPE_PRICE_ID_YEARLY=""                      # Optional yearly price; shows a second checkout button.

# --- Behaviour ---
TRIAL_DAYS="14"
DEMO_MODE="0"                                  # "1" skips the email-verification gate (local development only).

# --- Seed script only (npm run seed) ---
SEED_EMAIL="demo@truemargin.local"
SEED_PASSWORD="demo-passphrase-123"
