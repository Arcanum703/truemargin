generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  emailVerifiedAt    DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  signupSource       String?
  marketingOptOut    Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  sessions           Session[]
  tokens             AuthToken[]
  memberships        Membership[]
  auditLogs          AuditLog[]
  lifecycleEmails    LifecycleEmail[]
}

model LifecycleEmail {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  sentAt DateTime @default(now())

  @@unique([userId, kind])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipHash     String   @default("")
  userAgent  String   @default("")

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum Role {
  OWNER
  MEMBER
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role      @default(OWNER)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Workspace {
  id                   String             @id @default(cuid())
  name                 String             @default("My Etsy shop")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  trialEndsAt          DateTime
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  settings             Settings?
  orders               Order[]
  orderItems           OrderItem[]
  products             Product[]
  memberships          Membership[]
  auditLogs            AuditLog[]
}

model Settings {
  id                      String    @id @default(cuid())
  workspaceId             String    @unique
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hourlyRate              Float     @default(0)
  listingFee              Float     @default(0.2)
  transactionRate         Float     @default(6.5)
  paymentRate             Float     @default(3)
  paymentFixed            Float     @default(0.25)
  offsiteAdsEnabled       Boolean   @default(true)
  offsiteAdsRate          Float     @default(15)
  estimatedOffsitePercent Float     @default(0)
  defaultShippingCost     Float     @default(4)
  marginThreshold         Float     @default(30)
  targetMargin            Float     @default(40)
  updatedAt               DateTime  @updatedAt
}

model Order {
  id                   String      @id @default(cuid())
  workspaceId          String
  workspace            Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId           String
  saleDate             DateTime
  buyer                String      @default("")
  currency             String      @default("USD")
  orderValue           Float       @default(0)
  shipping             Float       @default(0)
  salesTax             Float       @default(0)
  orderTotal           Float       @default(0)
  status               String      @default("Completed")
  cardProcessingFees   Float?
  orderNet             Float?
  offsiteAdsAttributed Boolean     @default(false)
  items                OrderItem[]
  createdAt            DateTime    @default(now())

  @@unique([workspaceId, externalId])
  @@index([workspaceId, saleDate])
}

model OrderItem {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalOrderId String
  itemName        String
  buyer           String    @default("")
  quantity        Float     @default(1)
  price           Float     @default(0)
  itemTotal       Float     @default(0)
  currency        String    @default("USD")
  transactionId   String?
  sku             String    @default("")
  variations      String    @default("")
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
  @@index([orderId])
}

model Product {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  sku           String    @default("")
  materialCost  Float     @default(0)
  laborMinutes  Float     @default(0)
  packagingCost Float     @default(0)
  stockOnHand   Float     @default(0)
  reorderPoint  Float     @default(5)
  createdAt     DateTime  @default(now())

  @@unique([workspaceId, name])
}

model AuditLog {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  action      String
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ipHash      String     @default("")
  metadata    Json?

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}

model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}
